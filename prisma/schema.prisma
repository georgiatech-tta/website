generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth ---
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Club Data ---
model Player {
  id            String         @id @default(cuid())
  name          String
  email         String?        @unique
  leagueRating  Int            @default(500)
  usattRating   Int?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groupEntries  GroupEntry[]
  ratingHistory RatingHistory[]
}

model Season {
  id           String        @id @default(cuid())
  name         String        @unique // e.g. "Fall 2024"
  startDate    DateTime
  endDate      DateTime?
  leagueNights LeagueNight[]
}

model LeagueNight {
  id        String     @id @default(cuid())
  date      DateTime
  seasonId  String
  season    Season     @relation(fields: [seasonId], references: [id])
  groups    Group[]
  auditLog  AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Group {
  id            String       @id @default(cuid())
  leagueNightId String
  leagueNight   LeagueNight  @relation(fields: [leagueNightId], references: [id])
  tableNumber   Int?
  entries       GroupEntry[]
  matches       Match[]
}

model GroupEntry {
  id           String  @id @default(cuid())
  groupId      String
  group        Group   @relation(fields: [groupId], references: [id])
  playerId     String
  player       Player  @relation(fields: [playerId], references: [id])
  ratingBefore Int
  ratingAfter  Int?
  placement    Int?    // 1=winner, 2=runner-up, etc.

  @@unique([groupId, playerId])
}

model Match {
  id        String  @id @default(cuid())
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id])
  player1Id String
  player2Id String
  // Comma-separated per-game scores, e.g. "11-7,8-11,11-9"
  scoreP1   String
  scoreP2   String
  winnerId  String?
}

model RatingHistory {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  rating    Int
  source    String   // "league" | "usatt_sync" | "manual" | "import"
  notes     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id            String       @id @default(cuid())
  leagueNightId String?
  leagueNight   LeagueNight? @relation(fields: [leagueNightId], references: [id])
  adminEmail    String
  action        String       // "create" | "edit" | "delete"
  entityType    String
  entityId      String
  diff          Json?
  createdAt     DateTime     @default(now())
}

// --- Content ---
model NewsPost {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorEmail String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ScheduleEntry {
  id         String  @id @default(cuid())
  dayOfWeek  Int     // 0=Sun ... 6=Sat
  startTime  String  // "18:30"
  endTime    String  // "21:00"
  location   String
  type       String  // "league" | "training" | "casual"
  notes      String?
  active     Boolean @default(true)
}

model ScheduleException {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String
  cancelled Boolean  @default(true)
  notes     String?
}

model Officer {
  id    String @id @default(cuid())
  name  String
  role  String
  email String
  order Int    @default(0)
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String?
  url         String?
  description String?
  type        String   // "nctta" | "usatt" | "local" | "other"
  createdAt   DateTime @default(now())
}

model ResourceLink {
  id          String  @id @default(cuid())
  title       String
  url         String
  description String?
  order       Int     @default(0)
}

model Album {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  photos      Photo[]
}

model Photo {
  id        String   @id @default(cuid())
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id])
  url       String
  thumbUrl  String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model MailingSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}
